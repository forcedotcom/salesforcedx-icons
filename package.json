{
  "name": "@salesforce/salesforcedx-icons",
  "version": "0.1.0",
  "description": "Icon fonts for Salesforce's VSCode extensions.",
  "license": "BSD-3-Clause",
  "scripts": {
    "clean": "node ./scripts/reset.js --folders seti-icons,sfdx-icons",
    "svgo": "node ./scripts/run-icon-sets.js svgo",
    "sprite": "node ./scripts/run-icon-sets.js sprite",
    "export-ts": "node ./scripts/run-icon-sets.js export-ts",
    "export-csv": "node ./scripts/run-icon-sets.js export-csv",
    "fonts": "node ./scripts/run-icon-sets.js fonts",
    "copy-packages": "node ./scripts/copy-packages.js",
    "test": "node --test",
    "validate": "node ./scripts/validate-build.js",
    "build": "npm run clean && npm run svgo && npm run fonts && npm run export-ts && npm run export-csv && npm run sprite && npm run copy-packages",
    "postbuild": "node ./scripts/seti-color.js && npm run validate",
    "open": "for dir in seti-icons sfdx-icons; do open ./dist/${dir}/${dir}.html; done",
    "publish:seti": "cd ./dist/seti-icons && npm publish",
    "publish:sfdx": "cd ./dist/sfdx-icons && npm publish",
    "publish:both": "npm run publish:seti && npm run publish:sfdx",
    "pack-local": "node ./scripts/pack-local.js"
  },
  "repository": "forcedotcom/salesforcedx-icons",
  "bugs": {
    "url": "https://github.com/forcedotcom/salesforcedx-icons/issues"
  },
  "homepage": "https://github.com/forcedotcom/salesforcedx-icons#readme",
  "engines": {
    "node": ">=22.9.0",
    "npm": ">=10"
  },
  "devDependencies": {
    "@xmldom/xmldom": "0.9.10",
    "fantasticon": "4.1.0",
    "handlebars": "4.7.9",
    "minimist": "1.2.8",
    "opentype.js": "2.0.0",
    "svgo": "4.0.2"
  },
  "overrides": {
    "fantasticon": {
      "ttf2woff2": {
        "node-gyp": "12.4.0"
      }
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  }
}
